# 复制为 .env 后填入真实值。`.env` 已在 .gitignore 中，不会进仓库。

# ---- 必填：凭据加密密钥 ----
# 生成方式：python -m app.crypto
CHECKIN_FERNET_KEY=

# ---- 可选：Web 控制面板访问密码（留空则不开启访问鉴权） ----
# CHECKIN_WEB_PASSWORD=your_strong_password

# ---- 可选：监听地址 / 端口 / 时区 ----
CHECKIN_HOST=127.0.0.1
CHECKIN_PORT=8000
CHECKIN_TIMEZONE=Asia/Shanghai

# ---- 可选：数据目录（默认 ./data） ----
# CHECKIN_DATA_DIR=/var/lib/checkin-center

# ---- 可选：签到脚本超时与网络重试退避（秒） ----
CHECKIN_SCRIPT_TIMEOUT=300
CHECKIN_RETRY_DELAY=5

# ---- 可选：通知推送设置（多渠道） ----
NOTIFY_ENABLED=false
NOTIFY_TITLE=签到控制中心通知

# 1. Telegram Bot (配置 Bot Token 和 Chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Bark (iOS 推送，可填完整 URL 或设备 key)
BARK_URL=

# 3. Server酱 Turbo (SendKey)
SERVERCHAN_KEY=

# 4. PushPlus (推送加 Token)
PUSHPLUS_TOKEN=

# 5. 飞书群机器人 Webhook
FEISHU_WEBHOOK=

# 6. 钉钉群机器人 Webhook
DINGTALK_WEBHOOK=

# 7. 企业微信群机器人 Webhook
WECOM_WEBHOOK=

# 8. 自定义 HTTP Webhook POST 地址
CUSTOM_WEBHOOK_URL=

# ---- 可选：Google 表格记录（默认关闭） ----
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_ID=
SHEETS_WORKSHEET=签到记录
# service account JSON 文件路径，或 JSON 内容本身
SHEETS_CREDENTIALS=
